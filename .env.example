# Required: Google Gemini API Key for AI features (Style Quiz, Virtual Try-On, Chat, Lead Triage)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Vercel Blob token for file upload storage (if not set, images are stored as data URLs)
# Get from: https://vercel.com/dashboard/stores/blob
# VERCEL_BLOB_READ_WRITE_TOKEN=your_blob_token_here
